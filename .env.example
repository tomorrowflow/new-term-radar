# Required. A random string the OpenClaw skill sends as its bearer token: openssl rand -hex 24
RADAR_API_TOKEN=
# Required. X posts, search volumes, Google Trends and the models all go through it.
AISA_API_KEY=
# Optional.
GOANYAPI_API_KEY=
GITHUB_TOKEN=
TRUSTMRR_API_KEY=
# "on" runs sources at 00:00, 08:00, 16:00 UTC and daily at 01:30 UTC (about $15 a month with the example config).
RADAR_SCHEDULE=off
# Optional. Replace those slots with one full daily run (X and Hugging Face included) at HH:MM in TZ.
# RADAR_DAILY_AT=05:00
# TZ=Europe/Berlin
